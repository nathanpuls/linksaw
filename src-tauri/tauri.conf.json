{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linksaw",
  "version": "0.1.1",
  "identifier": "com.linksaw.snippets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "Linksaw", "width": 760, "height": 560,
      "minWidth": 620, "minHeight": 420, "resizable": true, "alwaysOnTop": true,
      "center": true, "visible": true, "decorations": false, "transparent": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg", "nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
