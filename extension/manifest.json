{
  "manifest_version": 3,
  "name": "Linksaw",
  "version": "2.0.0",
  "description": "Search and insert your Linksaw snippets.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dynamic.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Linksaw"
    },
    "open-autocomplete": {
      "description": "Open Linksaw search in the current field"
    }
  },
  "host_permissions": [
    "https://snippets-api.linksaw.com/*"
  ]
}
