{
  "name": "linksaw-snippets",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test src/*.test.mjs worker/*.test.mjs extension/*.test.mjs",
    "build": "vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mac:sign": "node scripts/sign-local-mac.mjs",
    "mac:build": "node scripts/prepare-session-helper.mjs && tauri build --bundles app && npm run mac:sign",
    "worker:dev": "wrangler dev --port 8799",
    "worker:migrate": "wrangler d1 migrations apply linksaw-snippets --local",
    "react:dev": "vite --config react-web/vite.config.ts",
    "react:build": "tsc -p react-web/tsconfig.json && vite build --config react-web/vite.config.ts",
    "react:test": "vitest run --config react-web/vitest.config.ts",
    "production:build": "VITE_API_BASE=https://snippets-api.linksaw.com npm run react:build && node scripts/build-production-web.mjs",
    "production:deploy": "npm run production:build && wrangler deploy --config wrangler.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide": "^1.46.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@tauri-apps/cli": "^2.8.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
